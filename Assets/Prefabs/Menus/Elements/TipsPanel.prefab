  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Rappel d\xE9finition : \nLa presbyacousie est le terme utilis\xE9 pour
    parler de la surdit\xE9 li\xE9e \xE0 l\u2019\xE2ge. Elle se manifeste d\u2019abord
    par des difficult\xE9s de compr\xE9hension dans le bruit, puis progressivement
    les difficult\xE9s peuvent appara\xEEtre plus g\xE9n\xE9ralement dans toutes
    les situations de communication. Elle est la cons\xE9quence d\u2019une d\xE9g\xE9n\xE9rescence
    des cellules cili\xE9es de la cochl\xE9e, du nerf, ou d\u2019autres structures
    que l\u2019on ne peut pas examiner par l\u2019otoscopie : c\u2019est donc l\u2019audiogramme
    qui permet de poser le diagnostic.\r\n\r\nLa forme classique est responsable
    d\u2019une surdit\xE9 neurosensorielle, bilat\xE9rale et sym\xE9trique, pr\xE9dominant
    sur les fr\xE9quences aigu\xEBs, avant d\u2019atteindre progressivement le reste
    des fr\xE9quences avec l\u2019avanc\xE9e en \xE2ge."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
